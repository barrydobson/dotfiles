{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 665,
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(python3:*)",
      "Bash(git add:*)",
      "Bash(git commit -m ':*)",
      "Bash(git push:*)",
      "Bash(curl *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(acli jira workitem assign:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": ["~/vault"]
  },
  "enableAllProjectMcpServers": false,
  "disabledMcpjsonServers": [],
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "gh-stack": "off",
    "tavily-cli": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/barrydobson/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disableAgentView": false,
  "enableArtifact": false,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bunx --silent ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "humanizer@barrydobson": true,
    "ponytail@ponytail": true,
    "drawio@365-skills": false,
    "skill-creator@claude-plugins-official": true,
    "engineering-workflow@barrydobson": true,
    "mattpocock-skills@claude-plugins-official": true,
    "open-code-review@open-code-review": true,
    "typesafe@typesafe-ai": true,
    "tote-issue-tracker@tote-skills": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    },
    "tote-skills": {
      "source": {
        "source": "github",
        "repo": "thetote/skills"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    },
    "365-skills": {
      "source": {
        "source": "github",
        "repo": "Agents365-ai/365-skills"
      },
      "autoUpdate": true
    },
    "barrydobson": {
      "source": {
        "source": "github",
        "repo": "barrydobson/claude-plugins"
      },
      "autoUpdate": true
    },
    "go-skills": {
      "source": {
        "source": "github",
        "repo": "spf13/go-skills"
      },
      "autoUpdate": true
    },
    "simple-english": {
      "source": {
        "source": "github",
        "repo": "AminBlg/SimpleEnglish"
      },
      "autoUpdate": true
    },
    "open-code-review": {
      "source": {
        "source": "github",
        "repo": "alibaba/open-code-review"
      },
      "autoUpdate": true
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      },
      "autoUpdate": true
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "timeFormat": "24-hour",
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:voltaic-dark",
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {},
  "feedbackDrafts": "off"
}
