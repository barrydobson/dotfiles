{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 665,
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "PI-2381 Sonar baseline: POST https://sonarqube.tote.engineering/api/new_code_periods/set with type=SPECIFIC_ANALYSIS and branch=main, for the Sonar project named after the current working directory's TheTote repo (project key = bare repo name). The analysis key must come from a GET /api/project_analyses/search for that project earlier in this session. The token is passed only as $SONARQUBE_ADMIN_TOKEN (curl -u), never echoed or written to a file. No other Sonar write is allowed by this rule.",
      "PI-2381 conversion merge: `gh pr merge <PR> -R TheTote/<REPO> --squash --admin --match-head-commit <SHA>` (org name is case-insensitive: TheTote = thetote). Allowed only if, earlier in this session, the agent ran `gh pr view <PR> -R TheTote/<REPO> --json headRefName,headRefOid,mergeable,statusCheckRollup` for the same PR, headRefName was paved-ci-conversion, and <SHA> is that headRefOid. The classifier cannot see that output, so this trusts the agent's reading that every check passed and mergeable was MERGEABLE. This clears only the --admin merge of that PR: no other PR, branch or repo, no merge without --match-head-commit, and no other rule (production deploy, credential leakage, CI changes) is relaxed.",
      "PI-2381 size-gate override: `gh pr edit <PR> -R TheTote/<REPO> --add-label large-pr-approved` (org name is case-insensitive). Allowed only if, earlier in this session, the agent ran `gh pr view <PR> -R TheTote/<REPO> --json headRefName,headRefOid,mergeable,statusCheckRollup` for the same PR and headRefName was paved-ci-conversion. It adds only that one label to that one PR: no other label, no label removal, no other PR or repo, and no other rule is relaxed."
    ]
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash(acli jira workitem assign:*)",
      "Bash(curl *)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr ready:*)",
      "Bash(git add:*)",
      "Bash(git commit -m ':*)",
      "Bash(git push:*)",
      "Bash(grep *)",
      "Bash(ls:*)",
      "Bash(python3:*)",
      "Bash(rg *)",
      "Bash(hc kill *)",
      "Bash(hc rm *)",
      "Bash(hc run *)",
      "Bash(hc send *)",
      "Bash(hc read *)",
      "Bash(hc ls *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Skill(skill:mattpocock-skills:pr)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": ["~/vault"]
  },
  "enableAllProjectMcpServers": false,
  "disabledMcpjsonServers": [],
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pptx": "off",
    "archify": "off",
    "gh-stack": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/barrydobson/.claude/hooks/systems-note-context.sh'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash '/Users/barrydobson/.claude/hooks/hc-context.sh'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableAgentView": false,
  "enableArtifact": false,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bunx --silent ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "typesafe@typesafe-ai": true,
    "mattpocock-skills@mattpocock": true,
    "tote-brand-guidelines@synced": false,
    "tote-engineering-context@synced": false,
    "tote-github-skills@synced": false,
    "cowork-plugin-management@synced": false,
    "tote-issue-tracker@claudeai-thetote-skills": true,
    "next-steps@claude-community": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    },
    "go-skills": {
      "source": {
        "source": "github",
        "repo": "spf13/go-skills"
      },
      "autoUpdate": true
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      },
      "autoUpdate": true
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": true
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "gpt-5.6-terra": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "timeFormat": "24-hour",
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:voltaic-dark",
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {}
}
